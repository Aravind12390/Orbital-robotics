<?xml version="1.0"?>
<robot name="go2_on_cart" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ── Tunable parameters ──────────────────────────────────────────── -->
  <xacro:property name="cart_damping"  value="0.0"/>
  <xacro:property name="cart_friction" value="0.0"/>
  <xacro:property name="pivot_damping" value="0.001"/>
  <xacro:property name="offload_force" value="11.0"/>   <!-- N: robot_mass*(9.81-g_target) -->

  <!-- Both trolleys share the same footprint so rod corners line up flush -->
  <xacro:property name="trolley_w"  value="0.7"/>    <!-- X length -->
  <xacro:property name="trolley_d"  value="0.5"/>    <!-- Y depth  -->
  <xacro:property name="trolley_h"  value="0.06"/>   <!-- Z plate thickness -->

  <!-- Rods sit 3 cm inside each corner edge -->
  <xacro:property name="cx"         value="${trolley_w/2 - 0.03}"/>
  <xacro:property name="cy"         value="${trolley_d/2 - 0.03}"/>
  <xacro:property name="rod_radius" value="0.018"/>

  <!-- Vertical clear span between bottom of gantry plate and top of lower plate -->
  <xacro:property name="rod_len"    value="2.3"/>
  <xacro:property name="rail_h"     value="3.2"/>   <!-- overhead rail above world origin -->

  <xacro:include filename="$(find unitree_go2_description)/urdf/unitree_go2_robot.xacro"/>

  <!-- ── Macro: one corner rod ──────────────────────────────────────────
       Each rod gets its OWN joint placing its frame at the exact corner
       of the gantry trolley's bottom face. The visual is then a simple
       centred cylinder — no tricky offset arithmetic needed. -->
  <xacro:macro name="corner_rod" params="name ox oy">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 ${-rod_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${rod_radius}" length="${rod_len}"/></geometry>
      </visual>
      <collision>
        <origin xyz="0 0 ${-rod_len/2}" rpy="0 0 0"/>
        <geometry><cylinder radius="${rod_radius}" length="${rod_len}"/></geometry>
      </collision>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>
    <!-- Joint origin is at the trolley bottom-face corner so the rod
         drops straight down from there to the lower trolley top face -->
    <joint name="${name}_joint" type="fixed">
      <parent link="gantry_trolley_link"/>
      <child link="${name}"/>
      <origin xyz="${ox} ${oy} ${-trolley_h/2}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- ── WORLD ─────────────────────────────────────────────────────────── -->
  <link name="world"/>

  <!-- ── OVERHEAD RAIL ─────────────────────────────────────────────────── -->
  <link name="overhead_rail_link">
    <visual><geometry><box size="${trolley_w * 7} 0.1 0.06"/></geometry></visual>
    <collision><geometry><box size="${trolley_w * 7} 0.1 0.06"/></geometry></collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>
  <joint name="rail_to_world" type="fixed">
    <parent link="world"/>
    <child link="overhead_rail_link"/>
    <origin xyz="0 0 ${rail_h}" rpy="0 0 0"/>
  </joint>

  <!-- ── GANTRY TROLLEY (upper, motorized — tracks robot in X) ──────────── -->
  <link name="gantry_trolley_link">
    <visual><geometry><box size="${trolley_w} ${trolley_d} ${trolley_h}"/></geometry></visual>
    <collision><geometry><box size="${trolley_w} ${trolley_d} ${trolley_h}"/></geometry></collision>
    <inertial>
      <mass value="3.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="gantry_slide" type="prismatic">
    <parent link="overhead_rail_link"/>
    <child link="gantry_trolley_link"/>
    <origin xyz="0 0 ${-(0.03 + trolley_h/2)}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.0" upper="3.0" effort="100" velocity="5.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ── FOUR CORNER RODS ───────────────────────────────────────────────── -->
  <xacro:corner_rod name="rod_fl" ox=" ${cx}"  oy=" ${cy}"/>
  <xacro:corner_rod name="rod_fr" ox=" ${cx}"  oy="-${cy}"/>
  <xacro:corner_rod name="rod_rl" ox="-${cx}"  oy=" ${cy}"/>
  <xacro:corner_rod name="rod_rr" ox="-${cx}"  oy="-${cy}"/>

  <!-- ── LOWER TROLLEY ──────────────────────────────────────────────────────
       Positioned so its TOP FACE aligns with the BOTTOM of the rods:
         z = -(trolley_h/2 + rod_len) puts the rod bottoms at the trolley top.
       Then subtract half the lower trolley thickness to centre the link.  -->
  <link name="lower_trolley_link">
    <visual><geometry><box size="${trolley_w} ${trolley_d} ${trolley_h}"/></geometry></visual>
    <collision><geometry><box size="${trolley_w} ${trolley_d} ${trolley_h}"/></geometry></collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/>
    </inertial>
  </link>
  <joint name="lower_cart_slide" type="fixed">
    <parent link="gantry_trolley_link"/>
    <child link="lower_trolley_link"/>
    <!-- trolley_h/2 (to gantry bottom) + rod_len (rods) + trolley_h/2 (to lower centre) -->
    <origin xyz="0 0 ${-(trolley_h + rod_len)}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.0" upper="2.0" effort="${offload_force}" velocity="5.0"/>
    <dynamics damping="${cart_damping}" friction="${cart_friction}"/>
  </joint>

  <!-- ── PIVOT (robot lies on its side on the lower trolley) ───────────────
       After rpy="1.5708 0 0", the robot's original Y axis points world -Z
       (downward). The Go2 body half-width in Y ≈ 0.10 m, so the pivot must
       be that far above the trolley top face to avoid clipping.
       If the robot still clips slightly: increase by 0.02 steps.
       If it floats above the plate: decrease by 0.02 steps. -->
  <joint name="pivot" type="revolute">
    <parent link="lower_trolley_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${trolley_h/2 + 0.15}" rpy="1.5708 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="3.14" effort="0" velocity="10.0"/>
    <dynamics damping="${pivot_damping}" friction="0.0"/>
  </joint>

</robot>
